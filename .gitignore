# ============================================================================
# Что не попадает в репозиторий.
# Всё перечисленное либо восстанавливается командами (npm install, build, seed),
# либо создаётся при запуске.
# ============================================================================

# --- зависимости ---
node_modules/

# --- секреты и локальные настройки ---
.env
.env.local

# --- база данных (создаётся командой npm run seed) ---
project/backend/data/db.json
project/backend/data/db.sqlite
project/backend/data/db.sqlite-shm
project/backend/data/db.sqlite-wal
project/backend/data/smoke-test-db.json

# --- загруженные через админку файлы ---
project/backend/data/uploads/*
!project/backend/data/uploads/.gitkeep

# --- сборки (создаются командой npm run build) ---
project/frontend/dist/
laba8/progress-app/dist/

# --- данные, которые лабораторная №7 создаёт при запуске ---
laba7/data/

# --- демонстрационный git-репозиторий лабораторной №2 ---
laba2/git-demo/

# --- временные файлы Word (создаются, когда документ открыт) ---
~$*.docx

# --- системное ---
*.log
.DS_Store
Thumbs.db
