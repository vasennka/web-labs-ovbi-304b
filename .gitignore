# ============================================================================
# Что НЕ попадает в репозиторий.
# Всё перечисленное либо восстанавливается командами (npm install, build, seed),
# либо генерируется при запуске — в репозитории этому не место.
# ============================================================================

# --- зависимости ---
node_modules/

# --- секреты и локальные настройки ---
.env
.env.local

# --- база данных (создаётся командой npm run seed) ---
project/backend/data/db.json
project/backend/data/db.sqlite
project/backend/data/db.sqlite-shm
project/backend/data/db.sqlite-wal
project/backend/data/smoke-test-db.json

# --- загруженные пользователем файлы (появляются при работе с админкой) ---
project/backend/data/uploads/*
!project/backend/data/uploads/.gitkeep

# --- сборки (создаются командой npm run build) ---
project/frontend/dist/
laba8/progress-app/dist/

# --- результаты запуска лабораторных (создаются ЗАПУСТИТЬ-ВСЁ.cmd) ---
вывод_лаба*.txt
laba7/data/

# --- служебные файлы отчёта (создаются tools/build-report.js) ---
отчёт/html/
отчёт/screenshot-plan.json

# --- демонстрационный git-репозиторий лабораторной №2 (создаётся скриптом) ---
laba2/git-demo/

# --- временные файлы Word (создаются при открытом документе) ---
~$*.docx

# --- системное ---
*.log
.DS_Store
Thumbs.db
