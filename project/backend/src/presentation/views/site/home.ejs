<%- include('../partials/site-header') %>

<section class="hero">
    <div class="hero-bg">
        <img src="/demo-photos/hero.jpg" alt="Фотостудия PRISMA">
    </div>

    <div class="hero-inner wrap fade-up">
        <p class="hero-eyebrow">Фотостудия в Москве · с 2020 года</p>
        <h1>Снимаем людей, события и предметы красиво и вовремя</h1>
        <p class="lead">
            Портрет, свадьба, репортаж и предметная съёмка. Своя студия на Пресне,
            свет Profoto, выезд по Москве и области. Превью — в течение 24 часов.
        </p>

        <div class="hero-actions">
            <a class="btn primary" href="/site/gallery">Смотреть галерею</a>
            <a class="btn" href="/site/contacts">Заказать съёмку</a>
        </div>

        <div class="hero-stats">
            <div><b>6 лет</b><span>на рынке</span></div>
            <div><b>400+</b><span>съёмок</span></div>
            <div><b>12</b><span>выставок</span></div>
            <div><b>24 часа</b><span>сдача превью</span></div>
        </div>

        <p class="muted small" style="margin-top: 22px">
            Эта страница отрисована на сервере шаблонизатором <b>EJS</b>.
            Та же страница на React доступна по адресу <a href="/">/</a> и берёт данные из REST API.
        </p>
    </div>
</section>

<div class="wrap">

<section>
    <div class="section-head">
        <div>
            <p class="eyebrow">Портфолио</p>
            <h2>Последние работы</h2>
        </div>
        <a href="/site/gallery">вся галерея →</a>
    </div>

    <div class="grid">
        <% gallery.forEach(function (photo) { %>
            <figure class="card">
                <div class="photo">
                    <img src="<%= photo.imageUrl %>" alt="<%= photo.title %>" loading="lazy">
                    <div class="overlay">
                        <h3><%= photo.title %></h3>
                        <p><%= photo.description %></p>
                    </div>
                </div>
                <figcaption>
                    <b><%= photo.title %></b>
                    <p class="meta">
                        <span class="tag"><%= photo.category %></span>
                        <%= photo.author %> · <%= photo.shotAt %>
                    </p>
                </figcaption>
            </figure>
        <% }); %>
    </div>
</section>

<div class="two-col">
    <section>
        <div class="section-head">
            <div>
                <p class="eyebrow">О студии</p>
                <h2><%= about.title %></h2>
            </div>
        </div>

        <% about.text.split('\n').slice(0, 2).forEach(function (paragraph) { %>
            <p class="lead"><%= paragraph %></p>
        <% }); %>

        <ul class="checklist">
            <% (about.values || []).slice(0, 4).forEach(function (value) { %>
                <li><%= value %></li>
            <% }); %>
        </ul>

        <div class="hero-actions" style="margin-top: 8px">
            <a class="btn" href="/site/about">Подробнее о студии</a>
            <a class="btn" href="/site/news">Новости студии</a>
        </div>
    </section>

    <section>
        <div class="photo-stack">
            <img src="/demo-photos/about-studio-2.jpg" alt="Студийная площадка" loading="lazy">
            <img src="/demo-photos/gallery-studio-1-2.jpg" alt="Схема света" loading="lazy">
            <img src="/demo-photos/about-team-2.jpg" alt="Команда студии" loading="lazy">
        </div>
    </section>
</div>

<section>
    <div class="section-head">
        <div>
            <p class="eyebrow">Журнал</p>
            <h2>Новости студии</h2>
        </div>
        <a href="/site/news">все новости →</a>
    </div>

    <div class="news-list">
        <% news.forEach(function (item) { %>
            <article class="card news">
                <a class="cover" href="/site/news/<%= item.slug %>">
                    <img src="<%= item.coverUrl || '/demo-photos/news-1.jpg' %>" alt="<%= item.title %>" loading="lazy">
                </a>
                <div class="body">
                    <time><%= new Date(item.publishedAt).toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' }) %></time>
                    <h3><a href="/site/news/<%= item.slug %>"><%= item.title %></a></h3>
                    <p><%= item.excerpt %></p>
                    <p class="meta">
                        <% (item.tags || []).forEach(function (t) { %>
                            <span class="tag"><%= t %></span>
                        <% }); %>
                    </p>
                </div>
            </article>
        <% }); %>
    </div>
</section>

</div>

<%- include('../partials/site-footer') %>
