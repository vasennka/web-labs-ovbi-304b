<%- include('../partials/site-header') %>

<article class="article">
    <p class="breadcrumbs"><a href="/site/news">← все новости</a></p>
    <h1><%= news.title %></h1>
    <p class="meta">
        <%= new Date(news.publishedAt).toLocaleString('ru-RU') %>
        <% (news.tags || []).forEach(function (t) { %><span class="tag"><%= t %></span><% }); %>
    </p>

    <% if (news.coverUrl) { %>
        <img class="cover" src="<%= news.coverUrl %>" alt="<%= news.title %>">
    <% } %>

    <% news.content.split('\n').forEach(function (paragraph) { %>
        <% if (paragraph.trim()) { %><p><%= paragraph %></p><% } %>
    <% }); %>

    <p class="muted small">Адрес страницы (slug): <code><%= news.slug %></code> — этот же ресурс доступен
        в REST API: <code>GET /api/v1/news/<%= news.slug %></code></p>
</article>

<%- include('../partials/site-footer') %>
