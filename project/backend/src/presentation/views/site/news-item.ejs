<%- include('../partials/site-header') %>

<div class="wrap">

<article class="article">
    <p class="breadcrumbs"><a href="/site/news">← все новости</a></p>
    <h1><%= news.title %></h1>
    <p class="meta">
        <time><%= new Date(news.publishedAt).toLocaleString('ru-RU') %></time>
        <% (news.tags || []).forEach(function (t) { %><span class="tag"><%= t %></span><% }); %>
    </p>

    <% if (news.coverUrl) { %>
        <img class="cover" src="<%= news.coverUrl %>" alt="<%= news.title %>">
    <% } %>

    <% news.content.split('\n').forEach(function (paragraph) { %>
        <% if (paragraph.trim()) { %><p><%= paragraph %></p><% } %>
    <% }); %>

    <div class="hero-actions">
        <a class="btn primary" href="/site/contacts">Обсудить съёмку</a>
        <a class="btn" href="/site/news">Другие новости</a>
    </div>

    <p class="muted small">
        Адрес страницы (slug): <code><%= news.slug %></code> — этот же ресурс доступен
        в REST API: <code>GET /api/v1/news/<%= news.slug %></code>
    </p>
</article>

</div>

<%- include('../partials/site-footer') %>
